{
  "name": "fragmentedfs",
  "version": "0.1.0",
  "description": "A filesystem split into many small files: hashed blobs with random names, one JSON document per file and per directory. A backend for browser-linux's virtio-fs and virtio-9p devices, usable on its own.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "scripts",
    "docs",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "fragmentedfs": "./scripts/fragmentedfs.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.mjs"
  },
  "keywords": [
    "filesystem",
    "virtio",
    "9p",
    "virtio-fs",
    "sha256",
    "browser-linux"
  ],
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2"
  }
}
