# Ubuntu 26.04 LTS for the webshell. Build from the repository root (tools/make-root.sh).
# GNU coreutils (Ubuntu's coreutils-from-gnu) instead of uutils: uutils' multicall binary checks /proc/self/exe against the
# utility name, which fails under Nanite (hard links all report the first name, /usr/bin/coreutils).
# The image's own programs (sources in demo/rootfs/usr/local/src) are compiled in a throwaway stage, so gcc stays out of the image:
# usage (system stats), ping (ICMP through the page's Wisp ping bridge), nanite-xkeys (the desktop's keyboard; its libraries come
# with ~/screen/install-desktop.sh).
FROM ubuntu:26.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev libx11-dev libxtst-dev
COPY demo/rootfs/usr/local/src/ /src/
RUN mkdir /out && cd /src && gcc -O2 -s -o /out/usage usage/usage.c && gcc -O2 -s -o /out/ping ping/ping.c -lm \
 && gcc -O2 -s -o /out/nanite-xkeys nanite-xkeys/nanite-xkeys.c -lX11 -lXtst

FROM ubuntu:26.04
# bash is root's login shell. (fish is dropped for now: fish 4 can exit 127 on Nanite at pipelines of programs,
# reports/nanite-bugs.md; its setup is kept in demo/fish/ for when it comes back.) python3 stays: fish brought it, and the
# Web Browser tab suggests python3 -m http.server.
RUN apt-get update \
 && apt-get install -y --allow-remove-essential coreutils-from-gnu coreutils-from-uutils- \
 && apt-get install -y --no-install-recommends python3 \
 && (apt-get purge -y --allow-remove-essential rust-coreutils || true) \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY demo/home/ /root/
COPY demo/rootfs/ /
COPY --from=build /out/ /usr/local/bin/
