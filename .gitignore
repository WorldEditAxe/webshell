# Dependencies
node_modules/

# Build output (npm run build, npm run cf:build)
/dist/
cf-dist/

# Root filesystems (tools/make-root.sh): FragmentedFS stores. Git keeps each one's metadata and blobs.gz/ (a gzip copy of
# every blob, what Cloudflare serves); blobs/, the raw copies, stay local.
public/roots/*.ffs/blobs/
public/roots/*.ffs.part/
cache/

# The Preview tabs' proxy, copied from node_modules (tools/vendor-proxy.mjs); nanite-transport.mjs is ours
public/proxy/*
!public/proxy/nanite-transport.mjs

# VS Code for the web (tools/get-vscode-web.sh)
public/vscode/web/

# Wrangler local state
.wrangler/
.dev.vars*

# Logs, local tooling, OS and editor files
logs/
*.log
.claude/
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
.env
.env.*
