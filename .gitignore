public/vscode/web/

# Wrangler local state
.wrangler/
.dev.vars*

# Logs, local tooling, OS and editor files
logs/
*.log
.claude/
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
.env
.env.*
